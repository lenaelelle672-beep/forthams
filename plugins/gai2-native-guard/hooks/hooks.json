{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$|^functions\\.exec_command$|^apply_patch$|^functions\\.apply_patch$|^Edit$|^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gai2-native-guard.sh\"",
            "commandWindows": "cmd /c \"\"%CLAUDE_PLUGIN_ROOT%\\hooks\\gai2-native-guard.cmd\"\"",
            "timeout": 10,
            "statusMessage": "Checking GAI2 native guard policy"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^Bash$|^functions\\.exec_command$|^apply_patch$|^functions\\.apply_patch$|^Edit$|^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gai2-native-guard.sh\"",
            "commandWindows": "cmd /c \"\"%CLAUDE_PLUGIN_ROOT%\\hooks\\gai2-native-guard.cmd\"\"",
            "timeout": 10,
            "statusMessage": "Checking GAI2 native guard permission policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$|^functions\\.exec_command$|^apply_patch$|^functions\\.apply_patch$|^Edit$|^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gai2-native-guard.sh\"",
            "commandWindows": "cmd /c \"\"%CLAUDE_PLUGIN_ROOT%\\hooks\\gai2-native-guard.cmd\"\"",
            "timeout": 10,
            "statusMessage": "Checking GAI2 native guard post-tool policy"
          }
        ]
      }
    ]
  }
}
