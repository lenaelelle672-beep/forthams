# forthAMS 环境变量示例
# 复制为 .env 并填入实际值，或直接设置为系统环境变量

# ========== 后端 ==========

# 数据库
DB_URL=jdbc:mysql://localhost:3306/ams_db?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_password

# JWT（必须设置，不设置则启动失败）
JWT_SECRET=your_custom_secret_at_least_256_bits_long_do_not_use_default
JWT_EXPIRATION=86400000

# CORS（逗号分隔，生产环境必须设置实际域名）
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ========== 前端 ==========
# VITE_API_BASE_URL 默认 /api，生产环境如有反向代理可保持默认

# ========== E2E 测试（可选） ==========
# AMS_E2E_REAL_BACKEND=true
# AMS_E2E_USERNAME=admin
# AMS_E2E_PASSWORD=your_password
# AMS_API_BASE=http://localhost:8080/api
