<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ams.mapper.AssetMapper">

    <!-- 批量更新资产 ABC 分类 -->
    <update id="updateABCBatch" parameterType="java.util.List">
        <foreach collection="list" item="asset" separator=";">
            UPDATE asset
            SET abc_classification = #{asset.abcClassification}
            WHERE id = #{asset.id}
              AND tenant_id = #{asset.tenantId}
        </foreach>
    </update>

</mapper>